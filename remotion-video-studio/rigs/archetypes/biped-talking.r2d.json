      "keys": [{ "at": [-30], "value": -22 }, { "at": [0], "value": 0 }, { "at": [30], "value": 22 }]
    },
    {
      "target": "warp:faceWarp.offsets",
      "params": ["AngleX"],
      "keys": [
        { "at": [-30], "value": { "3": [-6, 0], "4": [-10, 0], "5": [-6, 0] } },
        { "at": [0], "value": {} },
        { "at": [30], "value": { "3": [6, 0], "4": [10, 0], "5": [6, 0] } }
      ]
    },
    {
