  "ik": [
    { "id": "armLIk", "bones": ["armLUpper", "armLFore"], "target": "handLTarget", "mix": 1, "bendPositive": false, "softness": 8 },
    { "id": "armRIk", "bones": ["armRUpper", "armRFore"], "target": "handRTarget", "mix": 1, "bendPositive": true, "softness": 8 },
    { "id": "legLIk", "bones": ["legLUpper", "legLLower"], "target": "footLTarget", "mix": 1, "bendPositive": true, "softness": 6 },
    { "id": "legRIk", "bones": ["legRUpper", "legRLower"], "target": "footRTarget", "mix": 1, "bendPositive": false, "softness": 6 }
  ],
  "physics": [
    {
      "id": "scarfPhys",
      "inputs": [{ "param": "AngleZ", "type": "angle", "weight": 0.4 }, { "param": "HandLX", "type": "x", "weight": 0.12 }],
      "outputs": [
        { "param": "Scarf1", "segment": 0, "type": "angle", "scale": 0.8 },
        { "param": "Scarf2", "segment": 1, "type": "angle", "scale": 0.9 }
      ],
      "segments": [{ "length": 36, "mass": 1 }, { "length": 36, "mass": 0.8 }],
      "gravity": 980, "damping": 0.12, "stiffness": 18
    }
  ],
  "animations": [
    {
      "id": "idle",
      "duration": 2.4,
      "loop": true,
      "tracks": [
        { "target": "param:Breath", "keys": [{ "t": 0, "v": 0, "ease": "smooth" }, { "t": 1.2, "v": 1, "ease": "smooth" }, { "t": 2.4, "v": 0 }] },
        { "target": "param:EyeLOpen", "keys": [{ "t": 0, "v": 1 }, { "t": 1.6, "v": 1 }, { "t": 1.7, "v": 0 }, { "t": 1.82, "v": 1 }, { "t": 2.4, "v": 1 }] },
        { "target": "param:EyeROpen", "keys": [{ "t": 0, "v": 1 }, { "t": 1.6, "v": 1 }, { "t": 1.7, "v": 0 }, { "t": 1.82, "v": 1 }, { "t": 2.4, "v": 1 }] },
        { "target": "param:AngleZ", "keys": [{ "t": 0, "v": -2, "ease": "smooth" }, { "t": 1.2, "v": 4, "ease": "smooth" }, { "t": 2.4, "v": -2 }] }
      ]
    },
    {
      "id": "talk",
      "duration": 1.2,
      "loop": true,
      "tracks": [
        { "target": "param:MouthOpen", "keys": [{ "t": 0, "v": 0.1, "ease": "smooth" }, { "t": 0.2, "v": 0.85, "ease": "smooth" }, { "t": 0.45, "v": 0.25, "ease": "smooth" }, { "t": 0.75, "v": 0.95, "ease": "smooth" }, { "t": 1.2, "v": 0.1 }] },
        { "target": "param:HandLY", "keys": [{ "t": 0, "v": 0, "ease": "smooth" }, { "t": 0.6, "v": 32, "ease": "smooth" }, { "t": 1.2, "v": 0 }] }
      ]
    }
